# =============================================================================
# Dockerfile — BC Authorization
# Multi-stage build: builder (compilación) + runner (imagen mínima)
# =============================================================================

# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM golang:1.25-alpine AS builder

# Dependencias de compilación
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /app

# Copiar go.mod y go.sum primero para aprovechar el cache de Docker
COPY go.mod go.sum ./
RUN go mod download

# Copiar el código fuente completo
COPY . .

# Compilar solo el binario de Authorization
# CGO_ENABLED=0 → binario estático sin dependencias del sistema
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-w -s" \
    -o /app/bin/authorization \
    ./cmd/authorization/

# ── Stage 2: Runner ───────────────────────────────────────────────────────────
FROM alpine:3.19

# Certificados CA del sistema (para TLS hacia adquirente y NATS)
RUN apk add --no-cache ca-certificates tzdata wget

WORKDIR /app

# Copiar solo el binario compilado
COPY --from=builder /app/bin/authorization .


# Usuario no-root por seguridad
RUN addgroup -S posnet && adduser -S posnet -G posnet
USER posnet

EXPOSE 8080 9090

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q --spider http://localhost:8080/healthz || exit 1

ENTRYPOINT ["./authorization"]