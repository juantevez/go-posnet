# =============================================================================
# Dockerfile — BC fraud-detection
# =============================================================================

FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-w -s" \
    -o /app/bin/fraud-detection \
    ./cmd/fraud-detection/

FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata wget

WORKDIR /app

COPY --from=builder /app/bin/fraud-detection .
COPY --from=builder /app/migrations/fraud-detection ./migrations/fraud-detection

RUN addgroup -S posnet && adduser -S posnet -G posnet
USER posnet

EXPOSE 8083 9092


HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q --spider http://localhost:8083/healthz || exit 1

ENTRYPOINT ["./fraud-detection"]
