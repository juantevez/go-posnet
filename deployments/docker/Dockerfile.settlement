# =============================================================================
# Dockerfile — BC settlement
# =============================================================================

FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-w -s" \
    -o /app/bin/settlement \
    ./cmd/settlement/

FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata wget

WORKDIR /app

COPY --from=builder /app/bin/settlement .
COPY --from=builder /app/migrations/settlement ./migrations/settlement

RUN addgroup -S posnet && adduser -S posnet -G posnet
USER posnet

EXPOSE 8084 9093


HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q --spider http://localhost:8084/healthz || exit 1

ENTRYPOINT ["./settlement"]
