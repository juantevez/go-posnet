# =============================================================================
# Dockerfile — BC terminal-gateway
# =============================================================================

FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-w -s" \
    -o /app/bin/terminal-gateway \
    ./cmd/terminal-gateway/

FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata wget

WORKDIR /app

COPY --from=builder /app/bin/terminal-gateway .

RUN addgroup -S posnet && adduser -S posnet -G posnet
USER posnet

EXPOSE 8081 9091
EXPOSE 8082

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q --spider http://localhost:8081/healthz || exit 1

ENTRYPOINT ["./terminal-gateway"]