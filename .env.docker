# =============================================================================
# posnet-backend — Variables para Docker Compose (desarrollo local)
# Usar con: docker compose --env-file .env.docker up
# =============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=posnet
POSTGRES_PASSWORD=posnet123
POSTGRES_DB=posnet
POSTGRES_DSN=postgresql://posnet:posnet123@postgres:5432/posnet?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

# ─── NATS ─────────────────────────────────────────────────────────────────────
NATS_URL=nats://nats:4222
NATS_NKEY_PATH=
NATS_TLS_CERT=
NATS_TLS_KEY=
NATS_TLS_CA=

# ─── OpenTelemetry ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
ENVIRONMENT=development

# ─── BC Authorization ─────────────────────────────────────────────────────────
HTTP_PORT=8080
GRPC_PORT=9090
OTEL_SERVICE_NAME=posnet-authorization
OTEL_SERVICE_VERSION=1.0.0

# Adquirente — valores dummy para dev (no hay TLS real en local)
ACQUIRER_HOST=acquirer-mock
ACQUIRER_PORT=9100
ACQUIRER_TIMEOUT_SECONDS=30
# Usar "none" en lugar de "" para que requireEnv no haga panic
# El código de infraestructura del adquirente aún no está implementado
ACQUIRER_TLS_CERT=none
ACQUIRER_TLS_KEY=none
ACQUIRER_TLS_CA=none

# ─── BC Terminal Gateway ──────────────────────────────────────────────────────
# HTTP_PORT, GRPC_PORT, OTEL_SERVICE_NAME se sobreescriben por servicio
TLS_CERT_PATH=none
TLS_KEY_PATH=none
TLS_CA_PATH=none
SESSION_TTL_SECONDS=300
SESSION_CLEANUP_EVERY=1m
WS_PORT=8082

# ─── BC Fraud Detection ───────────────────────────────────────────────────────
ENGINE_EVAL_TIMEOUT=200ms
ENGINE_RULES_CACHE_TTL=5m
ENGINE_SCORE_THRESHOLD_REJECT=70
ENGINE_SCORE_THRESHOLD_REVIEW=50

# ─── BC Settlement ────────────────────────────────────────────────────────────
SETTLEMENT_MDR_PERCENT=2.5
SETTLEMENT_BATCH_CLOSE_HOUR=23
SETTLEMENT_SUBMIT_RETRIES=3
SETTLEMENT_SUBMIT_TIMEOUT=30s

# ─── BC Notification ──────────────────────────────────────────────────────────
TERMINAL_GATEWAY_GRPC_ADDR=terminal-gateway:9091
WEBHOOK_TIMEOUT=10s
WEBHOOK_DEFAULT_ENDPOINT=http://webhook-mock:9200/webhook
RETRY_JOB_INTERVAL=1m
RETRY_BATCH_SIZE=50
GRPC_CLIENT_TLS_CERT=
GRPC_CLIENT_TLS_KEY=
GRPC_CLIENT_TLS_CA=
